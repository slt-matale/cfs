# Copy this file to .env for local development.
# On Hugging Face Spaces: Settings -> Variables and secrets -> add these as Secrets.
# On Render/Railway/etc: add these in the platform's Environment Variables settings.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Optional - change these from the defaults for real use
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Required for the Negative Feedback Review page's AI suggestions/summary.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional - override which Gemini model is used. Google renames/retires
# models occasionally; if requests start failing, check
# https://ai.google.dev for the current flash model name.
GEMINI_MODEL=gemini-2.5-flash
