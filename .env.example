# Copy this file to .env for local development.
# On Hugging Face Spaces: Settings -> Variables and secrets -> add these as Secrets.
# On Render/Railway/etc: add these in the platform's Environment Variables settings.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Optional - change these from the defaults for real use
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
